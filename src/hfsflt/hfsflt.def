NAME HFSFLT
DESCRIPTION 'HFS/2 Diskette Filter Driver'
PROTMODE
DRIVER INITGLOBAL INITSTRATEGY

STACKSIZE 4096

EXPORTS
    STRAT1
    STRAT2
    INIT

SEGMENTS
    _TEXT CLASS 'CODE' PRELOAD
    _DATA CLASS 'DATA' PRELOAD
    _BSS CLASS 'BSS' PRELOAD
    DDHeader CLASS 'DATA' PRELOAD
    LIBDATA CLASS 'DATA' PRELOAD
    Code CLASS 'CODE' PRELOAD
    LIBCODE CLASS 'CODE' PRELOAD