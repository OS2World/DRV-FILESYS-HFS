import FSH_GETOVERLAPBUF      FSHELPER.19
import FSH_ISCURDIRPREFIX     FSHELPER.20
import FSH_LOADCHAR           FSHELPER.21
import FSH_PREVCHAR           FSHELPER.22
import FSH_STORECHAR          FSHELPER.23
import FSH_SEMSET             FSHELPER.24
import FSH_SEMSETWAIT         FSHELPER.25
import FSH_SEMWAIT            FSHELPER.26
import FSH_WILDMATCH          FSHELPER.27
import FSH_YIELD              FSHELPER.28
import FSH_DOVOLIO2           FSHELPER.29
import FSH_FINDCHAR           FSHELPER.30
import FSH_CANONICALIZE       FSHELPER.32
import FSH_QSYSINFO           FSHELPER.44
import FSH_NAMEFROMSFN        FSHELPER.45
import FSH_UPPERCASE          FSHELPER.46
